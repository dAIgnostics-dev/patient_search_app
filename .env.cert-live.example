# Copy to .env.cert-live.local. Restart Vite after editing.
# Application authentication (server only). Both credentials are needed.
CEZIH_CLIENT_ID=
CEZIH_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post. No automatic fallback.
CEZIH_TOKEN_AUTH_METHOD=client_secret_basic
# Set only if specified by CEZIH; do not copy the example token's scope.
CEZIH_SCOPE=
# Application-token routes. Add other IDs only when CEZIH confirms their auth contract.
CEZIH_APPLICATION_ENDPOINTS=CodeSystem.search,ValueSet.search,notification.pull
# Optional manual token for routes with unconfirmed auth; also an application fallback
# when client credentials are not configured. This token is not renewed automatically.
# Clinical/user routes always require a verified server-side CEZIH user session.
CEZIH_ACCESS_TOKEN=
# Optional PEM files, only if CEZIH requires a private CA or client TLS certificate.
# Paths are relative to the project root, or absolute.
CEZIH_CA_FILE=
CEZIH_CERT_FILE=
CEZIH_KEY_FILE=
# Never use VITE_ for secrets. Smart-card authentication/signing is separate.
