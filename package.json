{
  "name": "cezih-patient-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "auth:generate": "tsx scripts/generate-accounts.ts",
    "validate:routing": "node scripts/validate-source-routing.mjs",
    "validate:mappers": "node scripts/validate-mappers.mjs",
    "validate:services": "node scripts/validate-services.mjs",
    "validate:encounter-message": "tsx scripts/validate-encounter-message.ts",
    "validate:case-message": "tsx scripts/validate-case-message.ts",
    "validate:document-read": "tsx scripts/validate-document-read.ts",
    "validate:document-exchange": "tsx scripts/validate-document-exchange.ts",
    "validate:document-submit": "tsx scripts/validate-document-submit.ts",
    "validate:document-search": "tsx scripts/validate-document-search.ts",
    "validate:document-update": "tsx scripts/validate-document-update.ts",
    "validate:document-cancel": "tsx scripts/validate-document-cancel.ts",
    "validate:lom-notification": "tsx scripts/validate-lom-notification.ts",
    "validate:architecture": "npm run validate:routing && npm run validate:mappers && npm run validate:services && npm run validate:encounter-message && npm run validate:case-message && npm run validate:document-read && npm run validate:document-exchange && npm run validate:document-submit && npm run validate:document-search && npm run validate:document-update && npm run validate:document-cancel && npm run validate:lom-notification",
    "sandbox": "ampx sandbox",
    "verify:healthlake": "bash scripts/verify-healthlake-setup.sh",
    "verify:healthlake:fhir": "tsx scripts/verify-healthlake-fhir.ts",
    "verify:healthlake:proxy": "bash scripts/verify-healthlake-proxy.sh"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.374.0",
    "@aws-sdk/credential-provider-node": "^3.374.0",
    "@smithy/node-http-handler": "^4.0.0",
    "@smithy/protocol-http": "^5.4.6",
    "@smithy/signature-v4": "^5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.22.0",
    "@aws-amplify/backend-cli": "^1.4.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
