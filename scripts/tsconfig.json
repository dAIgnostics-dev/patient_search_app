{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": [
    "./**/*.ts",
    "../src/fhir/**/*.ts",
    "../src/mappers/**/*.ts",
    "../src/domain/**/*.ts"
  ],
  "references": [{ "path": "../amplify" }]
}
